# SolidWorks MCP Server Configuration
# Author: Samsaam Ali Baig
# Copy this file to .env and configure your settings

# SolidWorks Installation Path (optional)
SOLIDWORKS_PATH=C:\Program Files\SOLIDWORKS Corp\SOLIDWORKS

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Maximum scripts to keep in history
MAX_HISTORY=20
